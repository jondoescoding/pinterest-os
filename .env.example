# Copy to .env.local and fill in. Never commit .env.local.

# Local dev uses a libSQL file. For production, create a Turso DB:
#   turso db create pinterest-os
#   turso db show pinterest-os --url
#   turso db tokens create pinterest-os
DATABASE_URL=file:local.db
# DATABASE_URL=libsql://<your-db>.turso.io
# DATABASE_AUTH_TOKEN=

# Protects the dashboard with browser Basic authentication.
PINTEREST_OS_USERNAME=
PINTEREST_OS_PASSWORD=

# Protects machine-to-machine API access. Generate a separate long random
# value and keep it server-side.
PINTEREST_OS_API_KEY=
FAL_KEY=

POSTIZ_API_KEY=
POSTIZ_BASE_URL=https://api.postiz.com/public/v1

# Optional private VPS service. When omitted, local development uses the
# installed remove-ai-watermarks CLI directly.
METADATA_CLEANER_URL=
# Optional override. When empty, Pinterest OS derives a one-purpose cleaner
# token from FAL_KEY without sending the provider credential to the VPS.
METADATA_CLEANER_TOKEN=

# Deterministic Pinterest-native 2:3 poster composition.
POSTER_WIDTH=1000
POSTER_HEIGHT=1500
POSTER_BOTTOM_BAR_CANVAS_HEIGHT=150
POSTER_BOTTOM_BAR_BACKGROUND=#1b1b1b
POSTER_BRAND_NAME=Your Brand
POSTER_ACCENT_COLOR=#ffff00
POSTER_TEXT_COLOR=#ffffff
POSTER_COMPOSITION_VERSION=poster-bottom-bar-2x3-v4
# Optional explicit label. By default, configured local files are hashed.
# POSTER_ASSET_VERSION=brand-assets-v1
POSTER_LOGO_PATH=
POSTER_FONT_PATH=
POSTER_TEMPLATE_ASSET_PATH=

CHANNEL3_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
